{
  "name": "dre/custom-enchants",
  "description": "Custom Enchants plugin for PocketMine-MP",
  "version": "2.0.0",
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/AxolotlBucketLabs/SimplePacketHandler"
		}
	],
	"require": {
		"paroxity/commando": "dev-master",
		"muqsit/invmenu": "dev-pm5-delay-rework",
		"pup/placeholderapi": "v4.0.0",
		"muqsit/simple-packet-handler": "dev-main as 0.1.10",
		"ext-ctype": "*"
	},
	"require-dev": {
		"axolotl-pm/pocketmine-mp": "5.51.1"
	},
	"minimum-stability": "dev",
	"scripts": {
		"doctor": "@php ../DevTools/bin/devtools.php doctor --project=. --virions=virions-prepared",
		"prepare": "@php ../DevTools/bin/devtools.php prepare --project=. --virions=virions-prepared",
		"build": "@php -d phar.readonly=0 ../DevTools/bin/devtools.php build --project=. --virions=virions-prepared --out=.. --overwrite"	}
}